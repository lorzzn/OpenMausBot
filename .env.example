# Optional: Compose provides defaults when these settings are omitted.
COMPOSE_PROJECT_NAME=openmausbot
OMB_BIND_ADDRESS=127.0.0.1
OMB_HTTP_PORT=8080
# For direct HTTP on a public server, use OMB_BIND_ADDRESS=0.0.0.0 and
# OMB_HTTP_PORT=80. No additional HTTP Compose file or Caddy is needed.
# Optional compose.https.yaml overlay; IP certificates require make-https-cert.sh.
OMB_HTTPS_PORT=8443
# Optional compose.domain.yaml overlay; a bare public hostname, no scheme/path.
# That mode publishes ports 80/443 and sets both public URLs to https://<domain>.
OMB_DOMAIN=
# Leave empty to use http://localhost:${OMB_HTTP_PORT:-8080} in plain HTTP mode.
# Tunnel mode requires the public HTTPS URL here. Domain HTTPS sets it itself.
OMB_PUBLIC_URL=
# Leave empty to inherit OMB_PUBLIC_URL.
OMB_WEBHOOK_PUBLIC_URL=
# For the optional Caddy HTTPS overlay, set the HTTPS hostname (without scheme or path).
# Set OMB_PUBLIC_URL to https:// followed by the same hostname.
# Requires OMB_BIND_ADDRESS=127.0.0.1 and a trusted local HTTPS proxy.
OMB_HTTPS_HOST=
OMB_BASE_IMAGE=ghcr.io/milind-soni/openmausbot:latest
OMB_LOCAL_IMAGE=openmausbot-local:latest
# Used by compose.https.yaml and compose.domain.yaml; plain HTTP has no Caddy.
CADDY_IMAGE=caddy:2
# Explicitly empty ENGINES skips npm engine installation.
ENGINES="@anthropic-ai/claude-code @openai/codex"
# Leave empty for <COMPOSE_PROJECT_NAME>_data.
OMB_DATA_VOLUME=
# Use true only when reusing a volume that already exists.
OMB_DATA_EXTERNAL=false
